@model FitnessApp.ViewModels.CatalogListViewModel<FitnessApp.ViewModels.PassFormViewModel>
@{ ViewData["Title"] = "Gym passes"; }

<div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div><h1 class="page-heading">Gym passes</h1><p class="page-description">Manage your club's subscription types, prices, and visit limits.</p></div>
    <a asp-action="Create" class="btn btn-primary">Add pass type</a>
</div>
<section class="panel" aria-label="Pass catalog">
    <form asp-action="Index" method="get" class="flex flex-col gap-3 border-b border-slate-200 p-5 sm:flex-row sm:items-end">
        <div class="flex-1"><label for="pass-search" class="label">Find a pass</label><input id="pass-search" name="search" value="@Model.Search" type="search" class="input" placeholder="Search by pass name" maxlength="100" /></div>
        <button class="btn btn-secondary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.Search)) { <a asp-action="Index" class="btn btn-secondary">Clear</a> }
    </form>
    @if (Model.Error is not null)
    {
        <div class="panel-body"><div class="notice notice-error" role="alert">@Model.Error</div><a asp-action="Index" asp-route-search="@Model.Search" class="btn btn-secondary mt-4">Try again</a></div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="px-6 py-14 text-center"><h2 class="text-lg font-semibold text-slate-900">@(string.IsNullOrEmpty(Model.Search) ? "No pass types yet" : "No matching pass types")</h2><p class="mt-2 text-slate-600">@(string.IsNullOrEmpty(Model.Search) ? "Add a pass type to define its price, validity, and visit allowance." : "Try another pass name or clear your search.")</p><a asp-action="Create" class="btn btn-primary mt-5">Add pass type</a></div>
    }
    else
    {
        <div class="table-wrap"><table class="data-table"><caption class="sr-only">Gym pass types and subscription limits</caption><thead><tr><th scope="col">Pass type</th><th scope="col">Price</th><th scope="col">Visits</th><th scope="col">Validity</th><th scope="col">Actions</th></tr></thead><tbody>
        @foreach (var pass in Model.Items)
        {
            <tr><th scope="row"><a asp-action="Details" asp-route-id="@pass.Id" class="font-semibold text-slate-900 underline decoration-slate-300 underline-offset-4">@pass.Name</a></th><td>@pass.Price.ToString("0.00")</td><td>@pass.MaxVisits</td><td>@pass.ValidityDays days</td><td><div class="flex flex-wrap gap-4"><a asp-action="Edit" asp-route-id="@pass.Id" class="font-medium text-emerald-800 underline underline-offset-4" aria-label="Edit @pass.Name">Edit</a><a asp-action="Delete" asp-route-id="@pass.Id" class="font-medium text-red-700 underline underline-offset-4" aria-label="Delete @pass.Name">Delete</a></div></td></tr>
        }
        </tbody></table></div>
        <nav class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-5 py-4" aria-label="Pass catalog pages">
            <p class="text-sm text-slate-600">@Model.Total pass type(s) · Page @Model.Page of @Model.TotalPages</p><div class="flex gap-2">@if (Model.Page > 1) { <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" class="btn btn-secondary" rel="prev">Previous</a> }@if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" class="btn btn-secondary" rel="next">Next</a> }</div>
        </nav>
    }
</section>
