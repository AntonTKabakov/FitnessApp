@model FitnessApp.ViewModels.PassFormViewModel
<form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="space-y-6">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    @if (Model.Id.HasValue) { <input asp-for="Id" type="hidden" /> }
    <div><label asp-for="Name" class="label"></label><input asp-for="Name" class="input" autocomplete="off" maxlength="50" required /><span asp-validation-for="Name" class="field-error"></span></div>
    <div><label asp-for="Price" class="label"></label><input asp-for="Price" class="input" type="number" min="0" max="9999.99" step="0.01" inputmode="decimal" required /><span asp-validation-for="Price" class="field-error"></span></div>
    <div class="grid gap-6 sm:grid-cols-2">
        <div><label asp-for="MaxVisits" class="label"></label><input asp-for="MaxVisits" class="input" type="number" min="1" step="1" required /><span asp-validation-for="MaxVisits" class="field-error"></span></div>
        <div><label asp-for="ValidityDays" class="label"></label><input asp-for="ValidityDays" class="input" type="number" min="1" step="1" required /><span asp-validation-for="ValidityDays" class="field-error"></span></div>
    </div>
    <div class="flex flex-wrap gap-3 border-t border-slate-200 pt-6"><button type="submit" class="btn btn-primary">@(Model.Id.HasValue ? "Save changes" : "Create pass type")</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
