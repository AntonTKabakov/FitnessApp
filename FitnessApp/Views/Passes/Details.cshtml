@model FitnessApp.ViewModels.PassFormViewModel
@{ ViewData["Title"] = Model.Name; }
<div class="mb-8"><a asp-action="Index" class="mb-4 inline-block text-sm font-medium text-emerald-800 underline underline-offset-4">Back to gym passes</a><h1 class="page-heading">@Model.Name</h1><p class="page-description">Subscription settings and usage.</p></div>
<section class="panel max-w-2xl" aria-label="Pass type details"><div class="panel-body"><partial name="_Summary" model="Model" /><div class="mt-7 flex flex-wrap gap-3 border-t border-slate-200 pt-6"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit pass type</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-secondary">Delete pass type</a></div></div></section>
