@model FitnessApp.ViewModels.PassFormViewModel
<dl class="grid gap-6 sm:grid-cols-2"><div><dt class="text-sm text-slate-500">Pass name</dt><dd class="mt-1 break-words font-semibold text-slate-900">@Model.Name</dd></div><div><dt class="text-sm text-slate-500">Price</dt><dd class="mt-1 font-semibold text-slate-900">@Model.Price.ToString("0.00")</dd></div><div><dt class="text-sm text-slate-500">Maximum visits</dt><dd class="mt-1 font-semibold text-slate-900">@Model.MaxVisits</dd></div><div><dt class="text-sm text-slate-500">Validity</dt><dd class="mt-1 font-semibold text-slate-900">@Model.ValidityDays days</dd></div><div><dt class="text-sm text-slate-500">Purchased customer passes</dt><dd class="mt-1 font-semibold text-slate-900">@Model.PurchasedCount</dd></div></dl>
