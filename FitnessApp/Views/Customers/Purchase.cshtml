@model CustomerDetailsViewModel
@{ ViewData["Title"] = "Sell a pass"; }
<a class="text-link mb-5 inline-block text-sm" asp-action="Details" asp-route-id="@Model.Id">← Customer profile</a>
<h1 class="page-heading">Sell a pass</h1>
<p class="page-description mb-7">A new membership for @Model.DisplayName.</p>
<div class="panel max-w-2xl"><div class="panel-body">
    <span class="badge badge-neutral">Not available yet</span>
    <h2 class="mt-5 text-lg font-semibold">Pass sales need to be connected</h2>
    <p class="mt-3 text-sm leading-7 text-slate-600">Purchasing and renewing customer passes is not available in this application yet. Existing passes and remaining visits can still be viewed in the customer profile.</p>
    <div class="mt-6 flex flex-wrap gap-3"><a class="btn btn-secondary" asp-controller="Passes" asp-action="Index">View pass types</a><button class="btn btn-primary" type="button" disabled>Confirm purchase</button></div>
</div></div>
