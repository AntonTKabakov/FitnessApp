@model CheckinFormViewModel
@{ ViewData["Title"] = "New check-in"; }
<a class="text-link mb-5 inline-block text-sm" asp-action="Index">← Check-in history</a>
<h1 class="page-heading">Confirm entry</h1>
<p class="page-description mb-7">Find a valid pass, choose a trainer if needed, and check the customer in.</p>
<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
    <section class="panel" aria-label="Check-in form"><div class="panel-body">
        <h2 class="text-lg font-semibold"><span class="mr-2 text-emerald-700">01</span> Find a customer</h2>
        <form asp-action="Create" method="get" class="mt-4 flex flex-col gap-3 sm:flex-row" role="search">
            <label for="checkin-query" class="sr-only">Customer name or email</label><input id="checkin-query" class="input" name="query" value="@Model.Query" type="search" maxlength="100" placeholder="Customer name or email" />
            <button class="btn btn-secondary" type="submit">Find pass</button>
        </form>
        <form asp-action="Create" method="post" class="mt-6 space-y-6">
            <input type="hidden" name="Query" value="@Model.Query" />
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <fieldset>
                <legend class="label">Available passes</legend>
                <span asp-validation-for="CustomerPassId" class="field-error" id="pass-error"></span>
                @if (Model.Passes.Count == 0)
                {
                    <div class="notice notice-error" role="status">No valid passes with visits remaining were found. Search for another customer or check their membership.</div>
                }
                <div class="max-h-96 space-y-3 overflow-y-auto p-1">
                    @foreach (var pass in Model.Passes)
                    {
                        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 has-checked:border-emerald-600 has-checked:bg-emerald-50 @(pass.CheckedInToday ? "bg-slate-50 opacity-70" : "bg-white")">
                            <input asp-for="CustomerPassId" id="pass-@pass.Id" type="radio" value="@pass.Id" disabled="@pass.CheckedInToday" required class="mt-1 size-5 shrink-0 accent-emerald-700" aria-describedby="pass-error" />
                            <span class="min-w-0 flex-1"><span class="block break-words font-semibold">@pass.CustomerName</span><span class="mt-1 block text-sm text-slate-600">@pass.Name · #@pass.Id</span><span class="mt-2 block text-sm text-slate-600">@pass.RemainingVisits visits remaining · Until @pass.Expires.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                            @if (pass.CheckedInToday) { <span class="mt-2 block text-sm font-medium text-emerald-800">Already checked in today</span> }</span>
                        </label>
                    }
                </div>
                @if (Model.Passes.Count == 50) { <p class="mt-3 text-sm text-slate-500">Showing the first 50 passes. Search to narrow the results.</p> }
            </fieldset>
            <div class="border-t border-slate-200 pt-5">
                <label asp-for="TrainerId" class="label"><span class="mr-2 text-emerald-700">02</span> Trainer (optional)</label>
                <select asp-for="TrainerId" asp-items="Model.Trainers" class="input" aria-describedby="trainer-error"><option value="">Independent training</option></select>
                <span asp-validation-for="TrainerId" id="trainer-error" class="field-error"></span>
            </div>
            <div class="border-t border-slate-200 pt-5"><p class="mb-4 text-sm text-slate-500">Confirmation deducts one visit from the selected pass.</p><div class="flex flex-wrap gap-3"><button class="btn btn-primary" type="submit" disabled="@(!Model.Passes.Any(x => !x.CheckedInToday))"><partial name="_Icon" model='@("check")' /> Confirm entry</button><a class="btn btn-secondary" asp-action="Index">Cancel</a></div></div>
        </form>
    </div></section>
    <aside class="panel"><div class="panel-body"><h2 class="font-semibold">Ready to check in</h2><ol class="mt-4 list-decimal space-y-3 pl-5 text-sm leading-6 text-slate-600"><li>Choose a pass with a valid expiry date and visits remaining.</li><li>Add a trainer for a personal training visit.</li><li>Confirm entry. The date and time are recorded automatically.</li></ol><p class="notice notice-info mt-5">Each pass can be checked in once per day.</p></div></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
