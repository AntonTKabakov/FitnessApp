@model VisitRowViewModel
@{ ViewData["Title"] = "Check-in details"; }
<a class="text-link mb-5 inline-block text-sm" asp-action="Index">← Check-in history</a>
<div class="mb-7 flex flex-wrap items-start justify-between gap-4"><div><h1 class="page-heading">Check-in #@Model.Id</h1><p class="page-description">Recorded entry details.</p></div><span class="badge badge-success">Entry recorded</span></div>
<div class="panel max-w-3xl"><div class="panel-body">
    <partial name="_VisitSummary" model="Model" />
    @if (User.IsInRole(UserRoles.Admin))
    {
        <div class="mt-7 flex flex-wrap gap-3 border-t border-slate-200 pt-6"><a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit trainer</a><a class="btn btn-secondary" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">Customer profile</a><a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">Remove check-in</a></div>
    }
</div></div>
