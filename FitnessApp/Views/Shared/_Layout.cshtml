<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#047857" />
    <title>@ViewData["Title"] · FitnessApp</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a href="#main-content" class="sr-only fixed left-4 top-4 z-50 rounded-lg bg-white p-4 font-semibold text-emerald-800 shadow-lg focus:not-sr-only">Skip to content</a>
    <div class="min-h-screen lg:flex">
        <header class="sticky top-0 z-30 flex min-h-18 items-center justify-between border-b border-slate-200 bg-white px-5 lg:hidden">
            <a class="flex items-center gap-3 text-lg font-bold" asp-controller="Home" asp-action="Index">
                <span class="flex size-9 items-center justify-center rounded-xl bg-emerald-700 text-white" aria-hidden="true"><partial name="_Icon" model='@("activity")' /></span> FitnessApp
            </a>
            <button type="button" class="btn btn-secondary px-3" data-nav-toggle aria-controls="app-navigation" aria-expanded="false" aria-label="Open navigation"><partial name="_Icon" model='@("menu")' /></button>
        </header>
        <button type="button" class="fixed inset-0 z-30 bg-slate-950/40 lg:hidden" data-nav-backdrop hidden aria-label="Close navigation" tabindex="-1"></button>
        <aside id="app-navigation" data-nav-panel class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-slate-200 bg-white lg:flex">
            <div class="flex min-h-24 items-center justify-between px-6">
                <a class="flex items-center gap-3 text-xl font-bold tracking-tight" asp-controller="Home" asp-action="Index">
                    <span class="flex size-10 items-center justify-center rounded-xl bg-emerald-700 text-white" aria-hidden="true"><partial name="_Icon" model='@("activity")' /></span> FitnessApp
                </a>
                <button type="button" class="rounded-lg p-2 text-slate-500 lg:hidden" data-nav-close aria-label="Close navigation"><partial name="_Icon" model='@("close")' /></button>
            </div>
            <div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-4 pb-5">
                <p class="mb-3 px-4 text-xs font-semibold uppercase tracking-widest text-slate-400">Reception</p>
                <partial name="_Navigation" />
                <div class="mt-auto border-t border-slate-200 pt-5">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <p class="mb-3 px-4 text-sm font-semibold text-slate-700">Signed in</p>
                        <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-link w-full" type="submit"><partial name="_Icon" model='@("logout")' /> Sign out</button></form>
                    }
                    else { <a class="nav-link" asp-controller="Account" asp-action="Login"><partial name="_Icon" model='@("user")' /> Sign in</a> }
                    <a class="mt-3 block px-4 text-xs text-slate-500 underline-offset-4 hover:underline" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
        </aside>
        <div class="min-w-0 flex-1 lg:ml-64">
            <div class="hidden min-h-20 items-center justify-between border-b border-slate-200 bg-white px-8 lg:flex">
                <p class="text-sm font-medium text-slate-500">Fitness club management</p>
                <a class="btn btn-primary min-h-10 py-2" asp-controller="Visits" asp-action="Create"><partial name="_Icon" model='@("check")' /> New check-in</a>
            </div>
            <main id="main-content" class="mx-auto w-full max-w-screen-2xl p-5 sm:p-8 xl:p-10" tabindex="-1">
                <partial name="_Notifications" />
                @RenderBody()
            </main>
            <footer class="mx-auto flex max-w-screen-2xl flex-wrap items-center justify-between gap-3 px-5 py-6 text-xs text-slate-500 sm:px-8 xl:px-10">
                <span>FitnessApp · Reception workspace</span><span>@ReceptionTime.Today.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
            </footer>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
