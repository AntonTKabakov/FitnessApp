@model StatsViewModel
@{ ViewData["Title"] = "Statistics"; }

<div id="stats-app" data-endpoint="@Url.Action("Data")">
    <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
        <div>
            <span class="badge badge-success mb-3">Club insights</span>
            <h1 class="page-heading">Statistics</h1>
            <p class="page-description">Membership sales, attendance, and trainer activity in one place.</p>
        </div>
        <span class="badge badge-neutral">Europe/Sofia · EUR</span>
    </div>

    <section class="panel mb-6" aria-label="Reporting period">
        <form id="stats-filter" asp-action="Index" method="get" class="panel-body">
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
            <div class="flex flex-col items-end gap-4 xl:flex-row">
                <div class="w-full xl:w-56">
                    <label class="label" for="stats-range">Reporting period</label>
                    <select class="input" id="stats-range" name="Range">
                        <option value="Today" selected="@(Model.Filter.Range == StatsRange.Today)">Today</option>
                        <option value="Last7Days" selected="@(Model.Filter.Range == StatsRange.Last7Days)">Last 7 Days</option>
                        <option value="Last30Days" selected="@(Model.Filter.Range == StatsRange.Last30Days)">Last 30 Days</option>
                        <option value="ThisMonth" selected="@(Model.Filter.Range == StatsRange.ThisMonth)">This Month</option>
                        <option value="ThisYear" selected="@(Model.Filter.Range == StatsRange.ThisYear)">This Year</option>
                        <option value="Custom" selected="@(Model.Filter.Range == StatsRange.Custom)">Custom Date Range</option>
                    </select>
                </div>
                <div id="stats-custom" class="grid w-full gap-4 sm:grid-cols-2 xl:w-auto xl:flex-1">
                    <div>
                        <label class="label" for="stats-start">From</label>
                        <input class="input" type="date" name="Start" id="stats-start" value="@Model.Filter.Start?.ToString("yyyy-MM-dd")" max="@ReceptionTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="label" for="stats-end">To</label>
                        <input class="input" type="date" name="End" id="stats-end" value="@Model.Filter.End?.ToString("yyyy-MM-dd")" max="@ReceptionTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <button class="btn btn-primary w-full sm:w-auto" id="stats-apply" type="submit"><partial name="_Icon" model='@("refresh")' /> Apply period</button>
            </div>
            <p class="mt-3 text-xs leading-5 text-slate-500">Dates are inclusive. Custom reports can cover up to 366 days. All-time totals and current membership status stay independent of this filter.</p>
        </form>
    </section>

    <p id="stats-status" class="mb-4 text-sm text-slate-600" role="status" aria-live="polite"></p>
    <div id="stats-error" class="notice notice-error mb-5" role="alert" hidden></div>
    <div id="stats-dashboard" aria-busy="false">
        @if (Model.Report != null) { <partial name="_Dashboard" model="Model.Report" /> }
        else { <p class="notice notice-info">Choose a valid reporting period to load statistics.</p> }
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true" defer></script>
    <script src="~/js/stats.js" asp-append-version="true" defer></script>
}
