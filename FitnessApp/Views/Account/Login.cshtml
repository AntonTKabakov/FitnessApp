@model FitnessApp.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["Subtitle"] = "Access your fitness account.";
}

<div class="mx-auto w-full max-w-lg py-4 sm:py-10">
    <div class="mb-6">
        <h1 class="page-heading">Sign in</h1>
        <p class="page-description">Access your fitness account.</p>
    </div>
    <section class="panel" aria-label="Sign-in form">
        <div class="panel-body">
            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-5">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <div>
                    <label asp-for="Email" class="label"></label>
                    <input asp-for="Email" class="input" autocomplete="username" inputmode="email" maxlength="100" required aria-describedby="email-error" />
                    <span asp-validation-for="Email" class="field-error" id="email-error"></span>
                </div>
                <div>
                    <label asp-for="Password" class="label"></label>
                    <input asp-for="Password" class="input" autocomplete="current-password" maxlength="128" required aria-describedby="password-error" />
                    <span asp-validation-for="Password" class="field-error" id="password-error"></span>
                </div>
                <button type="submit" class="btn btn-primary w-full">Sign in</button>
            </form>
            <p class="mt-6 text-center text-sm text-slate-600">
                Need an account?
                <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-semibold text-emerald-700 underline-offset-4 hover:underline">Create an account</a>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
