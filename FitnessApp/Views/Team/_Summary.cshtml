@model FitnessApp.ViewModels.TrainerFormViewModel
<dl class="grid gap-6 sm:grid-cols-2"><div><dt class="text-sm text-slate-500">Full name</dt><dd class="mt-1 break-words font-semibold text-slate-900">@Model.FullName</dd></div><div><dt class="text-sm text-slate-500">Specialty</dt><dd class="mt-1 break-words font-semibold text-slate-900">@Model.Specialty</dd></div><div><dt class="text-sm text-slate-500">Phone number</dt><dd class="mt-1 font-semibold text-slate-900"><a href="tel:@Model.Phone" class="underline decoration-slate-300 underline-offset-4">@Model.Phone</a></dd></div><div><dt class="text-sm text-slate-500">Recorded visits</dt><dd class="mt-1 font-semibold text-slate-900">@Model.CheckinCount</dd></div></dl>
