@model FitnessApp.ViewModels.TrainerFormViewModel
@{ ViewData["Title"] = "Delete trainer"; }
<div class="mb-8"><a asp-action="Index" class="mb-4 inline-block text-sm font-medium text-emerald-800 underline underline-offset-4">Back to trainers</a><h1 class="page-heading">Delete trainer</h1><p class="page-description">Review this trainer's details before removing them.</p></div>
<section class="panel max-w-2xl" aria-label="Confirm trainer deletion"><div class="panel-body"><partial name="_Summary" model="Model" />
@if (Model.CheckinCount > 0)
{
    <div class="notice notice-info mt-6" role="status">This trainer has recorded visits and cannot be deleted. Their history is preserved.</div><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary mt-6">Back to trainer details</a>
}
else
{
    <div class="notice notice-error mt-6">Deleting this trainer is permanent.</div><form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-6 flex flex-wrap gap-3"><button type="submit" class="btn btn-danger">Delete trainer</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a></form>
}
</div></section>
