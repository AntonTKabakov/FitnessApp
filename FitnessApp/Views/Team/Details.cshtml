@model FitnessApp.ViewModels.TrainerFormViewModel
@{ ViewData["Title"] = Model.FullName; }
<div class="mb-8"><a asp-action="Index" class="mb-4 inline-block text-sm font-medium text-emerald-800 underline underline-offset-4">Back to trainers</a><h1 class="page-heading">@Model.FullName</h1><p class="page-description">Trainer profile and contact information.</p></div>
<section class="panel max-w-2xl" aria-label="Trainer details"><div class="panel-body"><partial name="_Summary" model="Model" /><div class="mt-7 flex flex-wrap gap-3 border-t border-slate-200 pt-6"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit trainer</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-secondary">Delete trainer</a></div></div></section>
