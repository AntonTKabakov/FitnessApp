@model CustomerDetailsViewModel
@{ ViewData["Title"] = "My account"; }
<div class="mb-7 flex flex-wrap items-start justify-between gap-4">
    <div><h1 class="page-heading">My account</h1><p class="page-description">Welcome, @Model.DisplayName. View your memberships and check in for your next visit.</p></div>
    <a class="btn btn-primary" asp-controller="Visits" asp-action="Create">Check in</a>
</div>
<section class="panel mb-7" aria-label="My details"><div class="panel-body">
    <h2 class="text-lg font-semibold">My details</h2>
    <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-3">
        <div><dt class="text-slate-500">Name</dt><dd class="mt-1 break-words font-semibold">@Model.DisplayName</dd></div>
        <div><dt class="text-slate-500">Email</dt><dd class="mt-1 break-all">@Model.Email</dd></div>
        <div><dt class="text-slate-500">Date of birth</dt><dd class="mt-1">@(Model.DateOfBirth?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "Not provided")</dd></div>
    </dl>
</div></section>
<section aria-labelledby="my-passes-heading" class="space-y-4">
    <h2 class="text-lg font-semibold" id="my-passes-heading">My membership passes</h2>
    @if (Model.Passes.Count == 0)
    {
        <div class="panel empty-state"><p class="font-semibold">No membership passes yet</p><p class="mt-2 text-sm text-slate-600">Ask your club administrator to assign a pass to your account.</p></div>
    }
    @foreach (var pass in Model.Passes) { <partial name="_CustomerPass" model="pass" /> }
</section>
<section class="panel mt-7" aria-labelledby="my-visits-heading">
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-5"><h2 id="my-visits-heading" class="text-lg font-semibold">My recent check-ins</h2><a class="text-link text-sm" asp-controller="Visits" asp-action="Index">View my history</a></div>
    <partial name="_VisitTable" model="Model.RecentVisits" />
</section>
