@{ ViewData["Title"] = "Privacy"; }
<h1 class="page-heading">Privacy</h1>
<div class="panel mt-7 max-w-3xl"><div class="panel-body space-y-5 text-sm leading-7 text-slate-600">
    <p>FitnessApp stores customer account details, membership passes, check-in history, and trainer contact information to support fitness club operations.</p>
    <p>Signing in uses HTTP-only access and refresh cookies. Forms also use an anti-forgery cookie to protect submissions.</p>
    <p>Contact your club administrator with questions about your personal information, access to your account, or the club’s data retention policy.</p>
</div></div>
